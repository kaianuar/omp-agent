{
  "productName": "DiskScope",
  "version": "0.1.0",
  "identifier": "com.diskscope.app",
  "build": {
    "frontendDist": "../gui/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../gui && npm run build",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "DiskScope",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleIdentifier": "com.diskscope.app",
      "entitlements": "entitlements.plist",
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "providerShortName": "",
      "category": "public.app-category.utilities"
    },
    "windows": {
      "certificateThumbprint": "",
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "appId": "com.diskscope.app",
      "maintainer": "DiskScope Team",
      "license": "MIT",
      "licenseFile": "",
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "librsvg2-2"]
      },
      "appimage": {
        "licenseFile": ""
      }
    }
  },
  "plugins": {
    "shell": {
      "enable": true
    },
    "fs": {
      "enable": true,
      "scope": {
        "allow": ["$HOME/**", "$TMP/**", "/media/**", "/mnt/**"]
      }
    },
    "dialog": {
      "enable": true
    },
    "opener": {
      "enable": true
    }
  }
}